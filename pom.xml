<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hireconnect</groupId>
    <artifactId>hireconnect</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>HireConnect</name>
    <description>HireConnect microservices</description>

    <modules>
        <module>analytics-service</module>
        <module>api-gateway</module>
        <module>application-service</module>
        <module>auth-service</module>
        <module>eureka-service</module>
        <module>interview-service</module>
        <module>job-service</module>
        <module>notification-service</module>
        <module>subscription-service</module>
        <module>user-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>hireconnect</sonar.projectKey>
        <sonar.projectName>HireConnect</sonar.projectName>
        <sonar.sourceEncoding>UTF-8</sonar.sourceEncoding>
        <sonar.exclusions>**/target/**,**/mvnw,**/mvnw.cmd,**/.mvn/**,**/hs_err_pid*.log,**/replay_pid*.log</sonar.exclusions>
        <sonar.coverage.exclusions>**/config/**,**/*Application.java,**/dto/**,**/entity/**,**/exception/**</sonar.coverage.exclusions>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>4.0.0.4121</version>
                    <!-- <version>5.1.0.4751</version> -->
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
